# Ferrox Enterprise Data Platform Configuration
PORT=8000
ENVIRONMENT=development

# Database Settings
# Leave blank or set MEMORY_DB=true to use lightning-fast in-memory persistence
DATABASE_URL=postgresql://ferrox:ferrox_secret@localhost:5434/ferrox_data
MEMORY_DB=false

# Cache / Rate Limiting
REDIS_URL=redis://localhost:6380/0

# Security & Sentinel Threat Engine
SENTINEL_BLOCK_SQLI=true
SENTINEL_BLOCK_XSS=true
SENTINEL_BLOCK_PATH_TRAVERSAL=true

# Logging
LOG_LEVEL=INFO
